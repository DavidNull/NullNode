[295.828926, "o", "\u001b[32mcase\u001b[39m\u001b(B\u001b[m \u001b(B\u001b[0;1m\u001b[31m$-\u001b[39m\u001b(B\u001b[m \u001b[32min\u001b[8;5H\u001b[39m\u001b(B\u001b[m*i*\u001b[32m)\u001b[39m\u001b(B\u001b[m \u001b[32m;;\u001b[9;7H\u001b[39m\u001b(B\u001b[m*\u001b[32m)\u001b[39m\u001b(B\u001b[m \u001b[32mreturn;;\r\u001b[10desac\r\u001b[12d\u001b[36m# don't put duplicate lines or lines starting with space in the history.\r\u001b[13d# See bash(1) for more options\r\u001b[14d\u001b[39m\u001b(B\u001b[mHISTCONTROL\u001b[32m=\u001b[39m\u001b(B\u001b[mignoreboth\r\u001b[16d\u001b[36m# append to the history file, don't overwrite it\r\u001b[17d\u001b[39m\u001b(B\u001b[mshopt\u001b(B\u001b[0;1m\u001b[35m -s\u001b[39m\u001b(B\u001b[m histappend\r\u001b[19d"]
[295.829132, "o", "\u001b[36m# for setting history length see HISTSIZE and HISTFILESIZE in bash(1)\r\u001b[20d\u001b[39m\u001b(B\u001b[mHISTSIZE\u001b[32m=\u001b[39m\u001b(B\u001b[m1000\r\u001b[21dHISTFILESIZE\u001b[32m=\u001b[39m\u001b(B\u001b[m2000\r\u001b[2d\u001b[?12l\u001b[?25h"]
