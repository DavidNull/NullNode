[155.194082, "o", "\r\n\u001b[0;34m┌─ Cloud mock (LocalStack + S3 + Secrets Manager)\u001b[0m\r\n"]
[155.194234, "o", "\u001b[0;34m==>\u001b[0m terraform init\r\n"]
[179.174354, "o", "\u001b[0;34m==>\u001b[0m terraform apply\r\n"]
[184.234549, "o", "\r\nTerraform used the selected providers to generate the following execution plan. Resource actions are indicated with the following symbols:\r\n  \u001b[32m+\u001b[0m create\u001b[0m\r\n\r\nTerraform will perform the following actions:\r\n\r\n\u001b[1m  # aws_s3_bucket.vault\u001b[0m will be created\r\n\u001b[0m  \u001b[32m+\u001b[0m\u001b[0m resource \"aws_s3_bucket\" \"vault\" {\r\n      \u001b[32m+\u001b[0m\u001b[0m acceleration_status         = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m acl                         = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m arn                         = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m bucket                      = \"nullnode-model-vault\"\r\n      \u001b[32m+\u001b[0m\u001b[0m bucket_domain_name          = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m bucket_prefix               = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m bucket_regional_domain_name = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m force_destroy               = false\r\n      \u001b[32m+\u001b[0m\u001b[0m hosted_zone_id              = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m id                          = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m object_lock_enabled         = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m policy                      = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m region                      = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m request_payer               = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m tags_all                    = {\r\n          \u001b[32m+\u001b[0m\u001b[0m \"ManagedBy\" = \"terraform\"\r\n          \u001b[32m+\u001b[0m\u001b[0m \"Mock\"      = \"localstack\"\r\n          \u001b[32m+\u001b[0m\u001b[0m \"Project\"   = \"nullnode\"\r\n        }\r\n      \u001b[32m+\u001b[0m\u001b[0m website_domain              = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m website_endpoint            = (known after apply)\r\n\r\n      \u001b[32m+\u001b[0m\u001b[0m cors_rule (known after apply)\r\n\r\n      \u001b[32m+\u001b[0m\u001b[0m grant (known after apply)\r\n\r\n      \u001b[32m+\u001b[0m\u001b[0m lifecycle_rule (known after apply)\r\n\r\n      \u001b[32m+\u001b[0m\u001b[0m logging (known after apply)\r\n\r\n      \u001b[32m+\u001b[0m\u001b[0m object_lock_configuration (known after apply)\r\n\r\n      \u001b[32m+\u001b[0m\u001b[0m replication_configuration (known after apply)\r\n\r\n      \u001b[32m+\u001b[0m\u001b[0m server_side_encryption_configuration (known after apply)\r\n\r\n      \u001b[32m+\u001b[0m\u001b[0m versioning (known after apply)\r\n\r\n      \u001b[32m+\u001b[0m\u001b[0m website (known after apply)\r\n    }\r\n\r\n\u001b[1m  # aws_s3_bucket_lifecycle_configuration.vault\u001b[0m will be created\r\n\u001b[0m  \u001b[32m+\u001b[0m\u001b[0m resource \"aws_s3_bucket_lifecycle_configuration\" \"vault\" {\r\n      \u001b[32m+\u001b[0m\u001b[0m bucket                                 = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m expected_bucket_owner                  = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m id                                     = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m transition_default_minimum_object_size = \"all_storage_classes_128K\"\r\n\r\n      \u001b[32m+\u001b[0m\u001b[0m rule {\r\n          \u001b[32m+\u001b[0m\u001b[0m id     = \"expire-audit-logs\"\r\n          \u001b[32m+\u001b[0m\u001b[0m status = \"Enabled\"\r\n            \u001b[90m# (1 unchanged attribute hidden)\u001b[0m\u001b[0m\r\n\r\n          \u001b[32m+\u001b[0m\u001b[0m expiration {\r\n              \u001b[32m+\u001b[0m\u001b[0m days                         = 30\r\n              \u001b[32m+\u001b[0m\u001b[0m expired_object_delete_marker = false\r\n            }\r\n\r\n          \u001b[32m+\u001b[0m\u001b[0m filter {\r\n              \u001b[32m+\u001b[0m\u001b[0m prefix = \"audit/\"\r\n            }\r\n        }\r\n    }\r\n\r\n\u001b[1m  # aws_s3_bucket_public_access_block.vault\u001b[0m will be created\r\n\u001b[0m  \u001b[32m+\u001b[0m\u001b[0m resource \"aws_s3_bucket_public_access_block\" \"vault\" {\r\n      \u001b[32m+\u001b[0m\u001b[0m block_public_acls       = true\r\n      \u001b[32m+\u001b[0m\u001b[0m block_public_policy     = true\r\n      \u001b[32m+\u001b[0m\u001b[0m bucket                  = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m id                      = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m ignore_public_acls      = true\r\n      \u001b[32m+\u001b[0m\u001b[0m restrict_public_buckets = true\r\n    }\r\n"]
[184.234646, "o", "\r\n\u001b[1m  # aws_s3_bucket_server_side_encryption_configuration.vault\u001b[0m will be created\r\n\u001b[0m  \u001b[32m+\u001b[0m\u001b[0m resource \"aws_s3_bucket_server_side_encryption_configuration\" \"vault\" {\r\n      \u001b[32m+\u001b[0m\u001b[0m bucket = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m id     = (known after apply)\r\n\r\n      \u001b[32m+\u001b[0m\u001b[0m rule {\r\n          \u001b[32m+\u001b[0m\u001b[0m apply_server_side_encryption_by_default {\r\n              \u001b[32m+\u001b[0m\u001b[0m sse_algorithm     = \"AES256\"\r\n                \u001b[90m# (1 unchanged attribute hidden)\u001b[0m\u001b[0m\r\n            }\r\n        }\r\n    }\r\n"]
[184.234696, "o", "\r\n\u001b[1m  # aws_s3_bucket_versioning.vault\u001b[0m will be created\r\n\u001b[0m  \u001b[32m+\u001b[0m\u001b[0m resource \"aws_s3_bucket_versioning\" \"vault\" {\r\n      \u001b[32m+\u001b[0m\u001b[0m bucket = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m id     = (known after apply)\r\n\r\n      \u001b[32m+\u001b[0m\u001b[0m versioning_configuration {\r\n          \u001b[32m+\u001b[0m\u001b[0m mfa_delete = (known after apply)\r\n          \u001b[32m+\u001b[0m\u001b[0m status     = \"Enabled\"\r\n        }\r\n    }\r\n\r\n\u001b[1m  # aws_secretsmanager_secret.department_keys\u001b[0m will be created\r\n\u001b[0m  \u001b[32m+\u001b[0m\u001b[0m resource \"aws_secretsmanager_secret\" \"department_keys\" {\r\n      \u001b[32m+\u001b[0m\u001b[0m arn                            = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m description                    = \"Virtual API keys per department, written by the LiteLLM bootstrap Job\"\r\n      \u001b[32m+\u001b[0m\u001b[0m force_overwrite_replica_secret = false\r\n      \u001b[32m+\u001b[0m\u001b[0m id                             = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m name                           = \"nullnode/litellm/department-keys\"\r\n      \u001b[32m+\u001b[0m\u001b[0m name_prefix                    = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m policy                         = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m recovery_window_in_days        = 0\r\n      \u001b[32m+\u001b[0m\u001b[0m tags_all                       = {\r\n          \u001b[32m+\u001b[0m\u001b[0m \"ManagedBy\" = \"terraform\"\r\n          \u001b[32m+\u001b[0m\u001b[0m \"Mock\"      = \"localstack\"\r\n          \u001b[32m+\u001b[0m\u001b[0m \"Project\"   = \"nullnode\"\r\n        }\r\n\r\n      \u001b[32m+\u001b[0m\u001b[0m replica (known after apply)\r\n    }\r\n"]
[184.23497, "o", "\r\n\u001b[1m  # aws_secretsmanager_secret.litellm\u001b[0m will be created\r\n\u001b[0m  \u001b[32m+\u001b[0m\u001b[0m resource \"aws_secretsmanager_secret\" \"litellm\" {\r\n      \u001b[32m+\u001b[0m\u001b[0m arn                            = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m description                    = \"Platform credentials: gateway keys, datastore and Grafana passwords\"\r\n      \u001b[32m+\u001b[0m\u001b[0m force_overwrite_replica_secret = false\r\n      \u001b[32m+\u001b[0m\u001b[0m id                             = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m name                           = \"nullnode/platform/credentials\"\r\n      \u001b[32m+\u001b[0m\u001b[0m name_prefix                    = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m policy                         = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m recovery_window_in_days        = 0\r\n      \u001b[32m+\u001b[0m\u001b[0m tags_all                       = {\r\n          \u001b[32m+\u001b[0m\u001b[0m \"ManagedBy\" = \"terraform\"\r\n          \u001b[32m+\u001b[0m\u001b[0m \"Mock\"      = \"localstack\"\r\n          \u001b[32m+\u001b[0m\u001b[0m \"Project\"   = \"nullnode\"\r\n        }\r\n\r\n      \u001b[32m+\u001b[0m\u001b[0m replica (known after apply)\r\n    }\r\n\r\n\u001b[1m  # aws_secretsmanager_secret_version.department_keys_placeholder\u001b[0m will be created\r\n\u001b[0m  \u001b[32m+\u001b[0m\u001b[0m resource \"aws_secretsmanager_secret_version\" \"department_keys_placeholder\" {\r\n      \u001b[32m+\u001b[0m\u001b[0m arn                  = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m has_secret_string_wo = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m id                   = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m secret_id            = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m secret_string        = (sensitive value)\r\n      \u001b[32m+\u001b[0m\u001b[0m secret_string_wo     = (write-only attribute)\r\n      \u001b[32m+\u001b[0m\u001b[0m version_id           = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m version_stages       = (known after apply)\r\n    }\r\n\r\n\u001b[1m  # aws_secretsmanager_secret_version.litellm\u001b[0m will be created\r\n\u001b[0m  \u001b[32m+\u001b[0m\u001b[0m resource \"aws_secretsmanager_secret_version\" \"litellm\" {\r\n      \u001b[32m+\u001b[0m\u001b[0m arn                  = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m has_secret_string_wo = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m id                   = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m secret_id            = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m secret_string        = (sensitive value)\r\n      \u001b[32m+\u001b[0m\u001b[0m secret_string_wo     = (write-only attribute)\r\n      \u001b[32m+\u001b[0m\u001b[0m version_id           = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m version_stages       = (known after apply)\r\n    }\r\n"]
[184.235223, "o", "\r\n\u001b[1m  # docker_container.localstack\u001b[0m will be created\r\n\u001b[0m  \u001b[32m+\u001b[0m\u001b[0m resource \"docker_container\" \"localstack\" {\r\n      \u001b[32m+\u001b[0m\u001b[0m attach                                      = false\r\n      \u001b[32m+\u001b[0m\u001b[0m bridge                                      = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m command                                     = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m container_logs                              = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m container_read_refresh_timeout_milliseconds = 15000\r\n      \u001b[32m+\u001b[0m\u001b[0m entrypoint                                  = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m env                                         = [\r\n          \u001b[32m+\u001b[0m\u001b[0m \"DEBUG=0\",\r\n          \u001b[32m+\u001b[0m\u001b[0m \"DEFAULT_REGION=eu-west-1\",\r\n          \u001b[32m+\u001b[0m\u001b[0m \"EAGER_SERVICE_LOADING=1\",\r\n          \u001b[32m+\u001b[0m\u001b[0m \"SERVICES=s3,secretsmanager\",\r\n        ]\r\n      \u001b[32m+\u001b[0m\u001b[0m exit_code                                   = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m hostname                                    = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m id                                          = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m image                                       = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m init                                        = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m ipc_mode                                    = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m log_driver                                  = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m logs                                        = false\r\n      \u001b[32m+\u001b[0m\u001b[0m memory_reservation                          = 0\r\n      \u001b[32m+\u001b[0m\u001b[0m must_run                                    = true\r\n      \u001b[32m+\u001b[0m\u001b[0m name                                        = \"nullnode-localstack\"\r\n      \u001b[32m+\u001b[0m\u001b[0m network_data                                = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m network_mode                                = \"bridge\"\r\n      \u001b[32m+\u001b[0m\u001b[0m read_only                                   = false\r\n      \u001b[32m+\u001b[0m\u001b[0m remove_volumes                              = true\r\n      \u001b[32m+\u001b[0m\u001b[0m restart                                     = \"unless-stopped\"\r\n      \u001b[32m+\u001b[0m\u001b[0m rm                                          = false\r\n      \u001b[32m+\u001b[0m\u001b[0m runtime                                     = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m security_opts                               = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m shm_size                                    = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m start                                       = true\r\n      \u001b[32m+\u001b[0m\u001b[0m stdin_open                                  = false\r\n      \u001b[32m+\u001b[0m\u001b[0m stop_signal                                 = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m stop_timeout                                = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m tty                                         = false\r\n      \u001b[32m+\u001b[0m\u001b[0m wait                                        = false\r\n      \u001b[32m+\u001b[0m\u001b[0m wait_timeout                                = 60\r\n\r\n      \u001b[32m+\u001b[0m\u001b[0m healthcheck {\r\n          \u001b[32m+\u001b[0m\u001b[0m interval       = \"5s\"\r\n          \u001b[32m+\u001b[0m\u001b[0m retries        = 20\r\n          \u001b[32m+\u001b[0m\u001b[0m start_interval = \"0s\"\r\n          \u001b[32m+\u001b[0m\u001b[0m start_period   = \"10s\"\r\n          \u001b[32m+\u001b[0m\u001b[0m test           = [\r\n              \u001b[32m+\u001b[0m\u001b[0m \"CMD-SHELL\",\r\n              \u001b[32m+\u001b[0m\u001b[0m \"curl -sf http://localhost:4566/_localstack/health || exit 1\",\r\n            ]\r\n          \u001b[32m+\u001b[0m\u001b[0m timeout        = \"5s\"\r\n        }\r\n\r\n      \u001b[32m+\u001b[0m\u001b[0m labels {\r\n          \u001b[32m+\u001b[0m\u001b[0m label = \"io.nullnode.component\"\r\n          \u001b[32m+\u001b[0m\u001b[0m value = \"cloud-mock\"\r\n        }\r\n\r\n      \u001b[32m+\u001b[0m\u001b[0m ports {\r\n          \u001b[32m+\u001b[0m\u001b[0m external = 4566\r\n          \u001b[32m+\u001b[0m\u001b[0m internal = 4566\r\n          \u001b[32m+\u001b[0m\u001b[0m ip       = \"0.0.0.0\"\r\n          \u001b[32m+\u001b[0m\u001b[0m protocol = \"tcp\"\r\n        }\r\n    }\r\n\r\n\u001b[1m  # docker_image.localstack\u001b[0m will be created\r\n\u001b[0m  \u001b[32m+\u001b[0m\u001b[0m resource \"docker_image\" \"localstack\" {\r\n      \u001b[32m+\u001b[0m\u001b"]
[184.23546, "o", "[0m id           = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m image_id     = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m keep_locally = true\r\n      \u001b[32m+\u001b[0m\u001b[0m name         = \"localstack/localstack:3.8.1\"\r\n      \u001b[32m+\u001b[0m\u001b[0m repo_digest  = (known after apply)\r\n    }\r\n\r\n\u001b[1m  # null_resource.localstack_ready\u001b[0m will be created\r\n\u001b[0m  \u001b[32m+\u001b[0m\u001b[0m resource \"null_resource\" \"localstack_ready\" {\r\n      \u001b[32m+\u001b[0m\u001b[0m id       = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m triggers = {\r\n          \u001b[32m+\u001b[0m\u001b[0m \"container_id\" = (known after apply)\r\n        }\r\n    }\r\n\r\n\u001b[1m  # random_password.grafana_password\u001b[0m will be created\r\n\u001b[0m  \u001b[32m+\u001b[0m\u001b[0m resource \"random_password\" \"grafana_password\" {\r\n      \u001b[32m+\u001b[0m\u001b[0m bcrypt_hash = (sensitive value)\r\n      \u001b[32m+\u001b[0m\u001b[0m id          = (known after apply)\r\n      \u001b[32m+\u001b[0m\u001b[0m length      = 24\r\n      \u001b[32m+\u001b[0m\u001b[0m lower       = true\r\n      \u001b[32m+\u001b[0m\u001b[0m min_lower   = 0\r\n      \u001b[32m+\u001b[0m\u001b[0m min_numeric = 0\r\n      \u001b[32m+\u001b[0m\u001b[0m min_special = 0\r\n      \u001b[32m+\u001b[0m\u001b[0m min_upper   = 0\r\n      \u001b[32m+\u001b[0m\u001b[0m number      = true\r\n      \u001b[32m+\u001b[0m\u001b[0m numeric     = true\r\n      \u001b[32m+\u001b[0m\u001b[0m result      = (sensitive value)\r\n      \u001b[32m+\u001b[0m\u001b[0m special     = false\r\n      \u001b[32m+\u001b[0m\u001b[0m upper       = true\r\n    }\r\n"]
